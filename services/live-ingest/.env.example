# Google Cloud project ID (e.g. my-gcp-project)
PROJECT_ID=your-gcp-project-id

# GCP region where the Live Stream API resources will be created
LOCATION=us-central1

# GCS bucket name (no gs:// prefix) where HLS segments will be written
BUCKET_NAME=your-bucket-name

# Unique identifier for the Live Stream channel resource
CHANNEL_ID=my-cooking-show-channel

# Unique identifier for the RTMP input endpoint resource
INPUT_ID=my-rtmp-input
