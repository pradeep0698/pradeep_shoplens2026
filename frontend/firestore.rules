rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/UserProfiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/UserProfiles/$(request.auth.uid)).data.get('role', 'user') == 'admin';
    }

    match /UserProfiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /LiveShoppingSessions/{sessionId} {
      allow read: if true;
      allow write: if false;
    }

    match /VideoAnalysisCache/{fileName} {
      allow read, write: if request.auth != null;
    }

    match /VideoAnnotations/{fileName} {
      allow read, write: if request.auth != null;
    }
  }
}
