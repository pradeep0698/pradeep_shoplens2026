    {
      "name": "_Flows",
      "description": "End-to-end chained flows. Run these folders in sequence to test the full pipeline.",
      "item": [
        {
          "name": "Full Analyze Pipeline",
          "description": "Mirrors the live pipeline: analyze → match → save to session.\nRun requests in order.",
          "item": [
            {
              "name": "1. Analyze Image",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status 200', () => pm.response.to.have.status(200));",
                      "let body = {};",
                      "try { body = pm.response.json(); } catch (e) {}",
                      "pm.collectionVariables.set('detected_items', JSON.stringify(body.items || []));",
                      "console.log('[FLOW:1] items=' + JSON.stringify(body.items));"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"image_url\": \"https://upload.wikimedia.org/wikipedia/commons/thumb/3/3a/Cat03.jpg/320px-Cat03.jpg\",\n  \"transcript\": \"\",\n  \"ignore_terms\": [],\n  \"query\": \"\",\n  \"country\": \"us\",\n  \"max_searches\": 3\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{ai_analyzer_url}}/analyze",
                  "host": ["{{ai_analyzer_url}}"],
                  "path": ["analyze"]
                }
              },
              "response": []
            },
            {
              "name": "2. Match Products",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const items = JSON.parse(pm.collectionVariables.get('detected_items') || '[]');",
                      "const body = { items: items, ignore_terms: [], max_searches: 3 };",
                      "pm.request.body.raw = JSON.stringify(body);"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status 200', () => pm.response.to.have.status(200));",
                      "let body = {};",
                      "try { body = pm.response.json(); } catch (e) {}",
                      "pm.collectionVariables.set('matched_products', JSON.stringify(body.matched_products || []));",
                      "console.log('[FLOW:2] matched=' + (body.matched_products || []).length);"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\"items\": [], \"ignore_terms\": [], \"max_searches\": 3}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{product_matcher_url}}/match",
                  "host": ["{{product_matcher_url}}"],
                  "path": ["match"]
                }
              },
              "response": []
            },
            {
              "name": "3. Save to Session",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const products = JSON.parse(pm.collectionVariables.get('matched_products') || '[]');",
                      "pm.request.body.raw = JSON.stringify({ products: products });"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
