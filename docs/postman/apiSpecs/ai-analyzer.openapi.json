{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Analyzer",
    "description": "Gemini-powered image and video analysis service. Accepts an image (base64 or URL) or a GCS video segment URI, runs Gemini to detect shoppable items, searches Google Shopping via SerpAPI, and returns structured product results.\n\n**Auth:** none required \u2014 CORS is open (`*`).\n\n**Typical flow:** `POST /analyze` \u2192 items + products in one call. Use `POST /analyze/stream` for progressive results (one NDJSON line per item as it resolves). Use `POST /identify` when the client has already cropped to a single product.",
    "version": "1.0.0"
  },
  "paths": {
    "/config": {
      "get": {
        "tags": [
          "Config"
        ],
        "summary": "Get active Gemini model",
        "operationId": "get_config_config_get",
        "responses": {
          "200": {
            "description": "Currently active model ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigResponse"
                },
                "example": {
                  "model": "gemini-2.5-pro"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Config"
        ],
        "summary": "Set active Gemini model",
        "operationId": "update_config_config_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfigRequest"
              },
              "examples": {
                "switch_to_flash": {
                  "summary": "Switch to Gemini 2.5 Flash",
                  "value": {
                    "model": "gemini-2.5-flash"
                  }
                },
                "switch_to_pro": {
                  "summary": "Switch to Gemini 2.5 Pro (default)",
                  "value": {
                    "model": "gemini-2.5-pro"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Newly active model ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigResponse"
                },
                "example": {
                  "model": "gemini-2.5-flash"
                }
              }
            }
          },
          "422": {
            "description": "Request body failed Pydantic validation (e.g. wrong type, missing required field)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/analyze": {
      "post": {
        "tags": [
          "Analysis"
        ],
        "summary": "Analyze image or video segment",
        "description": "Runs Gemini on the provided image or GCS video segment to detect shoppable items, then searches Google Shopping for each detected item via SerpAPI.\n\nProvide exactly one of: `gcs_uri`, `image_url`, or `image_data`.\n\nReturns all results at once. For progressive streaming use `POST /analyze/stream`.",
        "operationId": "analyze_analyze_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeRequest"
              },
              "examples": {
                "image_url": {
                  "summary": "Analyze a public image URL",
                  "value": {
                    "image_url": "https://picsum.photos/id/1080/640/480.jpg",
                    "transcript": "",
                    "ignore_terms": [],
                    "query": "",
                    "country": "us",
                    "max_searches": 5,
                    "preference_terms": [],
                    "shopping_categories": []
                  }
                },
                "image_data_base64": {
                  "summary": "Analyze a base64-encoded image",
                  "value": {
                    "image_data": "<base64-encoded JPEG/PNG/WebP bytes>",
                    "image_mime_type": "image/jpeg",
                    "transcript": "",
                    "ignore_terms": [],
                    "query": "",
                    "country": "us",
                    "max_searches": 5,
                    "preference_terms": [],
                    "shopping_categories": []
                  }
                },
                "gcs_video_uri": {
                  "summary": "Analyze a live-stream HLS segment (called by Pub/Sub Worker)",
                  "value": {
                    "gcs_uri": "gs://shoplens2026-dev-hls-segments/live/segment001.ts",
                    "transcript": "And here you can see the stand mixer being used to knead the dough",
                    "ignore_terms": [],
                    "query": "",
                    "country": "us",
                    "max_searches": 5,
                    "preference_terms": [],
                    "shopping_categories": []
                  }
                },
                "with_mlkit_context": {
                  "summary": "Analyze with on-device ML Kit context forwarded for log-based routing analysis",
                  "value": {
                    "image_url": "https://picsum.photos/id/1080/640/480.jpg",
                    "transcript": "",
                    "ignore_terms": [],
                    "query": "",
                    "country": "us",
                    "max_searches": 5,
                    "preference_terms": [],
                    "shopping_categories": [],
                    "mlkit_context": {
                      "route": "gemini_fallback",
                      "trigger": "auto",
                      "on_device_confidence": 0.41,
                      "detected_objects_count": 2,
                      "detected_labels": [
                        {
                          "text": "Furniture"
                        },
                        {
                          "text": "Chair"
                        }
                      ]
                    }
                  }
                },
                "with_profile_context": {
                  "summary": "Analyze with user profile preferences \u2014 biases which items get a Lens search when more items are detected than max_searches allows",
                  "value": {
                    "image_url": "https://picsum.photos/id/1080/640/480.jpg",
                    "transcript": "",
                    "ignore_terms": [],
                    "query": "",
                    "country": "gb",
                    "max_searches": 3,
                    "preference_terms": [
                      "minimalist",
                      "Nike"
                    ],
                    "shopping_categories": [
                      "Electronics",
                      "Furniture"
                    ]
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Detection and matching succeeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyzeResponse"
                },
                "example": {
                  "items": [
                    "stand mixer"
                  ],
                  "products": [
                    {
                      "product_id": "walmart-beautiful-3-5-qt-ecca45",
                      "name": "Beautiful 3.5 Qt Stand Mixer",
                      "price": 64.96,
                      "image_url": "https://encrypted-tbn1.gstatic.com/shopping?q=tbn:ANd9GcSqMqBie2aAONKedRN2VEXA1q2-",
                      "purchase_url": "https://www.walmart.com/ip/Beautiful-3-5-Qt-Stand-Mixer/expr123",
                      "seller": "Walmart",
                      "category": "Kitchen & Cookware"
                    }
                  ],
                  "warnings": [],
                  "gcs_uri": null,
                  "image_url": "https://picsum.photos/id/1080/640/480.jpg",
                  "country": "us",
                  "currency": "USD"
                }
              }
            }
          },
          "400": {
            "description": "No media input provided",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                },
                "example": {
                  "detail": "Provide gcs_uri, image_url, or image_data.",
                  "error_code": "INVALID_REQUEST"
                }
              }
            }
          },
          "500": {
            "description": "Gemini or SerpAPI error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                },
                "example": {
                  "detail": "403 PERMISSION_DENIED. {'error': {'code': 403, 'message': \"Unable to open file: gs://bucket/segment.ts, mode=Read_Mode, status=PERMISSION_DENIED: ...\", 'status': 'PERMISSION_DENIED'}}",
                  "error_code": "INTERNAL_ERROR"
                }
              }
            }
          },
          "422": {
            "description": "Request body failed Pydantic validation (e.g. wrong type, missing required field)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "502": {
            "description": "Upstream Gemini/GCS/SerpAPI call timed out or failed at the network layer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                },
                "example": {
                  "detail": "Connection timed out while contacting Vertex AI",
                  "error_code": "UPSTREAM_ERROR"
                }
              }
            }
          }
        }
      }
    },
    "/analyze/stream": {
      "post": {
        "tags": [
          "Analysis"
        ],
        "summary": "Analyze image \u2014 streaming NDJSON",
        "description": "Same detection + matching pipeline as `POST /analyze`, but streams one NDJSON line per event as it completes rather than waiting for all items.\n\n**Event types** (each line is a JSON object):\n- `{\"type\": \"items\", \"items\": [...]}` \u2014 emitted once after Gemini detection\n- `{\"type\": \"match\", \"name\": \"...\", \"products\": [...], \"warnings\": [...]}` \u2014 once per item\n- `{\"type\": \"done\", \"warnings\": [...]}` \u2014 stream end\n- `{\"type\": \"error\", \"detail\": \"...\", \"error_code\": \"...\"}` \u2014 on failure\n\n**Does not support `gcs_uri`** \u2014 video segments have no per-item fan-out to stream. Provide `image_url` or `image_data`.",
        "operationId": "analyze_stream_analyze_stream_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeRequest"
              },
              "examples": {
                "image_url": {
                  "summary": "Stream analysis of a public image URL",
                  "value": {
                    "image_url": "https://picsum.photos/id/1080/640/480.jpg",
                    "transcript": "",
                    "ignore_terms": [],
                    "query": "",
                    "country": "us",
                    "max_searches": 5,
                    "preference_terms": [],
                    "shopping_categories": []
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "NDJSON stream \u2014 one JSON object per line. `type` is one of `items`, `match`, `done`, `error`.",
            "content": {
              "application/x-ndjson": {
                "schema": {
                  "type": "object",
                  "description": "One of 4 shapes depending on `type`",
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "items"
                        },
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "type",
                        "items"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "match"
                        },
                        "name": {
                          "type": "string"
                        },
                        "products": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/ProductItem"
                          }
                        },
                        "warnings": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "type",
                        "name",
                        "products",
                        "warnings"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "done"
                        },
                        "warnings": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "country": {
                          "type": "string"
                        },
                        "currency": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "type",
                        "warnings",
                        "country",
                        "currency"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "error"
                        },
                        "detail": {
                          "type": "string"
                        },
                        "error_code": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "type",
                        "detail",
                        "error_code"
                      ]
                    }
                  ]
                },
                "example": {
                  "type": "match",
                  "name": "stand mixer",
                  "products": [
                    {
                      "product_id": "walmart-beautiful-3-5-qt-ecca45",
                      "name": "Beautiful 3.5 Qt Stand Mixer",
                      "price": 64.96,
                      "image_url": "https://encrypted-tbn1.gstatic.com/shopping?q=tbn:ANd9GcSqMqBie2aAONKedRN2VEXA1q2-",
                      "purchase_url": "https://www.walmart.com/ip/Beautiful-3-5-Qt-Stand-Mixer/expr123",
                      "seller": "Walmart",
                      "category": "Kitchen & Cookware"
                    }
                  ],
                  "warnings": []
                }
              }
            }
          },
          "400": {
            "description": "Neither image_url nor image_data provided (gcs_uri is not supported here)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                },
                "example": {
                  "detail": "Provide image_url or image_data.",
                  "error_code": "REQUEST_ERROR"
                }
              }
            }
          },
          "422": {
            "description": "Request body failed Pydantic validation (e.g. wrong type, missing required field)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/identify": {
      "post": {
        "tags": [
          "Analysis"
        ],
        "summary": "Identify a cropped product image",
        "description": "Skips Gemini bounding-box detection \u2014 the crop is already selected by ML Kit on-device. Still calls Gemini once to produce a rich text description (color, material, brand, style) that improves Google Lens recall, then uploads to GCS and runs Lens. Faster than /analyze because there is one Gemini call instead of N (one per detected object).\n\nRequires `image_data` (base64). `image_url` is not supported.",
        "operationId": "identify_identify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeRequest"
              },
              "examples": {
                "cropped_image_with_mlkit_context": {
                  "summary": "Identify an ML-Kit-cropped product image",
                  "value": {
                    "image_data": "<base64-encoded JPEG bytes of the on-device crop>",
                    "image_mime_type": "image/jpeg",
                    "query": "",
                    "ignore_terms": [],
                    "country": "us",
                    "max_searches": 5,
                    "mlkit_context": {
                      "route": "on_device_confident",
                      "trigger": "tap",
                      "on_device_confidence": 0.92,
                      "detected_objects_count": 1,
                      "detected_labels": [
                        {
                          "text": "Kitchen Appliance"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Product identification succeeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentifyResponse"
                },
                "example": {
                  "items": [],
                  "products": [
                    {
                      "product_id": "walmart-beautiful-3-5-qt-ecca45",
                      "name": "Beautiful 3.5 Qt Stand Mixer",
                      "price": 64.96,
                      "image_url": "https://encrypted-tbn1.gstatic.com/shopping?q=tbn:ANd9GcSqMqBie2aAONKedRN2VEXA1q2-",
                      "purchase_url": "https://www.walmart.com/ip/Beautiful-3-5-Qt-Stand-Mixer/expr123",
                      "seller": "Walmart",
                      "category": "Kitchen & Cookware"
                    }
                  ],
                  "warnings": [],
                  "country": "us",
                  "currency": "USD"
                }
              }
            }
          },
          "400": {
            "description": "image_data not provided \u2014 /identify does not accept image_url",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                },
                "example": {
                  "detail": "Provide image_data.",
                  "error_code": "INVALID_REQUEST"
                }
              }
            }
          },
          "422": {
            "description": "Request body failed Pydantic validation (e.g. wrong type, missing required field)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Health check",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Service liveness and env var presence",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok",
                  "gcs_lens_bucket_set": true,
                  "serpapi_key_set": true,
                  "project_id_set": true
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalyzeRequest": {
        "properties": {
          "gcs_uri": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gcs Uri",
            "description": "GCS URI of a video segment to analyze (e.g. gs://bucket/live/seg001.ts). Mutually exclusive with image_url/image_data."
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url",
            "description": "Publicly accessible image URL. Mutually exclusive with gcs_uri/image_data."
          },
          "image_data": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Data",
            "description": "Base64-encoded image bytes. Required for /identify. Mutually exclusive with gcs_uri/image_url."
          },
          "image_mime_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Mime Type",
            "description": "MIME type for image_data (e.g. image/jpeg, image/webp, image/png)."
          },
          "transcript": {
            "type": "string",
            "title": "Transcript",
            "description": "Optional transcript text to supplement Gemini's visual analysis",
            "default": ""
          },
          "ignore_terms": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Ignore Terms",
            "description": "Product names to exclude from matching results"
          },
          "query": {
            "type": "string",
            "title": "Query",
            "description": "Optional freetext query to bias Google Shopping search",
            "default": ""
          },
          "country": {
            "type": "string",
            "title": "Country",
            "description": "Two-letter ISO country code for regional product search. Empty/unset defaults to 'us'. Currency is derived from this (no separate currency field) \u2014 see the `currency` field on the response.",
            "default": "us"
          },
          "max_searches": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Max Searches",
            "description": "Maximum number of SerpAPI searches to execute",
            "default": 5
          },
          "preference_terms": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Preference Terms",
            "description": "Free-text style/brand/material preferences from the user's profile (e.g. 'minimalist', 'Nike'). Used to prioritize which detected items get a product search when there are more items than max_searches allows."
          },
          "shopping_categories": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Shopping Categories",
            "description": "Preferred shopping categories from the user's profile (e.g. 'Furniture', 'Electronics'). Same prioritization role as preference_terms."
          },
          "mlkit_context": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MlKitContext"
              },
              {
                "type": "null"
              }
            ],
            "description": "On-device ML Kit detection context forwarded from the mobile app. Used for log-based routing analysis only \u2014 does not affect Gemini behaviour."
          }
        },
        "type": "object",
        "title": "AnalyzeRequest",
        "examples": [
          {
            "country": "us",
            "ignore_terms": [],
            "image_url": "https://example.com/product.jpg",
            "max_searches": 5,
            "preference_terms": [],
            "query": "",
            "shopping_categories": [],
            "transcript": ""
          }
        ]
      },
      "ConfigRequest": {
        "properties": {
          "model": {
            "type": "string",
            "title": "Model",
            "description": "Gemini model ID to activate (e.g. gemini-2.5-flash, gemini-2.5-pro)"
          }
        },
        "type": "object",
        "required": [
          "model"
        ],
        "title": "ConfigRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MlKitContext": {
        "properties": {
          "route": {
            "type": "string",
            "title": "Route",
            "description": "Routing decision: 'on_device_confident' or 'gemini_fallback'"
          },
          "trigger": {
            "type": "string",
            "title": "Trigger",
            "description": "What triggered the request: 'tap' or 'auto'"
          },
          "on_device_confidence": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "On Device Confidence",
            "description": "ML Kit confidence score (0.0\u20131.0)"
          },
          "detected_objects_count": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Detected Objects Count",
            "description": "Number of objects detected on-device"
          },
          "detected_labels": {
            "items": {
              "$ref": "#/components/schemas/MlKitLabel"
            },
            "type": "array",
            "title": "Detected Labels",
            "description": "Top labels from ML Kit on-device detection"
          }
        },
        "type": "object",
        "required": [
          "route",
          "trigger"
        ],
        "title": "MlKitContext"
      },
      "MlKitLabel": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text",
            "description": "Label text returned by ML Kit on-device classifier"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "MlKitLabel"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "ProductItem": {
        "type": "object",
        "description": "A matched, purchasable product returned by Google Shopping search.",
        "properties": {
          "product_id": {
            "type": "string",
