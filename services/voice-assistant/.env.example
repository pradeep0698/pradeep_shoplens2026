# LOCATION must be "us-central1" for the native-audio VOICE_MODEL below —
# unlike the older cascade model (gemini-live-2.5-flash, only reachable at
# "global"), the native-audio variant is currently only available at
# us-central1; global returns a 1008 policy-violation close on connect.
PROJECT_ID=shoplens-dev-499700
LOCATION=us-central1
VOICE_MODEL=gemini-live-2.5-flash-native-audio
# Cheap text-only model for the separate structured-extraction call that
# parses the transcript into shopping_categories/preference_terms/ignore_terms
# (kept separate from VOICE_MODEL so the Live model only has to converse).
EXTRACTION_MODEL=gemini-2.5-flash
# One of gemini-live-2.5-flash's 8 prebuilt voices: Puck, Charon, Kore,
# Fenrir, Aoede, Leda, Orus, Zephyr.
VOICE_NAME=Puck
# Pure cost/runaway-session backstop — decoupled from the nudge/auto-save
# logic below, which is driven by genuine inactivity instead.
SESSION_MAX_SECONDS=600
# How long the conversation must be genuinely silent before nudging the
# model to check in, and how much further silence after that nudge before
# giving up and auto-saving whatever's been captured.
INACTIVITY_NUDGE_SECONDS=45
INACTIVITY_CLOSE_GRACE_SECONDS=20
SESSION_CONTEXT_WINDOW_TOKENS=32000
# Base URL of the product-matcher Cloud Run service — used by the
# search_products tool (non-onboarding voice sessions) to run Google
# Shopping searches via SerpAPI.
PRODUCT_MATCHER_URL=https://your-product-matcher-cloud-run-url
PORT=8080
# Path to service account JSON key file (omit to use Application Default Credentials)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Google AI Studio (Gemini Developer API) key — used ONLY to mint ephemeral
# auth tokens for the mobile app's direct client->Gemini Live connection
# (native platforms only). Separate from PROJECT_ID/Vertex AI above, since
# ephemeral tokens are unsupported on Vertex AI clients in the installed SDK.
AI_STUDIO_API_KEY=<your-key>
# Developer-API model id for the direct-connect path — naming differs from
# the Vertex AI VOICE_MODEL above (confirmed via a live models.list() call:
# requires the "models/" prefix and a "-latest"/dated-preview suffix rather
# than a version number).
VOICE_MODEL_DEV_API=models/gemini-2.5-flash-native-audio-latest
# Server-side kill switch for the direct-connect transport — when false (the
# default), every client falls back to the WS proxy regardless of platform
# or mobile build flags.
VOICE_DIRECT_CONNECT_ENABLED=false