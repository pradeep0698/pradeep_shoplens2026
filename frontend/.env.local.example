# Local development only. For GitHub Actions deployment, use GitHub Secrets instead.
#
# Firebase config — get values from:
# Firebase Console > shoplens-dev-prj > Project Settings > Your apps > Web app > SDK setup

NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=shoplens-dev-prj.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=shoplens-dev-prj
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=shoplens-dev-prj.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# Live session tracking
NEXT_PUBLIC_SESSION_ID=live-session-001

# Demo API endpoints (use localhost for local dev, Cloud Run URLs for deployment)
NEXT_PUBLIC_ANALYZER_API_URL=http://localhost:8081
NEXT_PUBLIC_MATCHER_API_URL=http://localhost:8082
NEXT_PUBLIC_STATE_API_URL=http://localhost:8083

# HLS stream URL — from Cloud Live Stream channel output bucket
# gs://shoplens-dev-hls-segments/live/playlist.m3u8
NEXT_PUBLIC_HLS_STREAM_URL=https://storage.googleapis.com/shoplens-dev-hls-segments/live/playlist.m3u8

# ── GitHub Actions Secrets required (Settings > Secrets and variables > Actions) ──
#
#   WIF_PROVIDER                  → projects/YOUR_PROJECT_NUMBER/locations/global/workloadIdentityPools/github-pool/providers/github-provider
#   WIF_SERVICE_ACCOUNT           → shoplens-runner@shoplens-dev-prj.iam.gserviceaccount.com
#   FIREBASE_API_KEY              → NEXT_PUBLIC_FIREBASE_API_KEY value
#   FIREBASE_MESSAGING_SENDER_ID  → NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID value
#   FIREBASE_APP_ID               → NEXT_PUBLIC_FIREBASE_APP_ID value
#   AI_ANALYZER_URL               → deployed Cloud Run URL for ai-analyzer
#   PRODUCT_MATCHER_URL           → deployed Cloud Run URL for product-matcher
#   STATE_MANAGER_URL             → deployed Cloud Run URL for state-manager
#   HLS_STREAM_URL                → NEXT_PUBLIC_HLS_STREAM_URL value
