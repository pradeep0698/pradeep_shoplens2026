    {
      "name": "Voice Assistant",
      "description": "Gemini Live voice preference management.\nBase URL: {{voice_assistant_url}}\n\nAll endpoints require Firebase Authentication.\nSet {{firebase_token}} to a valid Firebase ID token before running.\n\nWebSocket stream: wss://{{voice_assistant_url}}/voice/session/{session_id}/stream\n(WebSocket cannot be tested in Postman REST client — use a WS client or the mobile app.)",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{voice_assistant_url}}/health",
              "host": ["{{voice_assistant_url}}"],
              "path": ["health"]
            }
          },
          "response": []
        },
        {
          "name": "Start Voice Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "let body = {};",
                  "try { body = pm.response.json(); } catch (e) {}",
                  "if (body.session_id) {",
                  "  pm.collectionVariables.set('voice_session_id', body.session_id);",
                  "  console.log('[VOICE] session_id=' + body.session_id + ' ws_url=' + body.ws_url);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{firebase_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{voice_assistant_url}}/voice/session/start",
              "host": ["{{voice_assistant_url}}"],
              "path": ["voice", "session", "start"]
            }
          },
          "response": []
        },
        {
          "name": "Send Session Event",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{firebase_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_id\": \"{{voice_session_id}}\",\n  \"event_type\": \"user_message\",\n  \"payload\": {\n    \"text\": \"I am allergic to nuts\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{voice_assistant_url}}/voice/session/event",
              "host": ["{{voice_assistant_url}}"],
              "path": ["voice", "session", "event"]
            }
          },
          "response": []
        },
        {
          "name": "Finalize Voice Session",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{firebase_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_id\": \"{{voice_session_id}}\",\n  \"confirmed_patch\": {\n    \"preference_terms\": [\"organic\", \"non-stick\"],\n    \"ignore_terms\": [\"plastic\"],\n    \"allergies\": [\"nuts\", \"gluten\"],\n    \"dietary_restrictions\": [\"vegan\"],\n    \"max_searches_per_run\": 5\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{voice_assistant_url}}/voice/session/finalize",
              "host": ["{{voice_assistant_url}}"],
              "path": ["voice", "session", "finalize"]
            }
          },
          "response": []
        }
      ]
    },
